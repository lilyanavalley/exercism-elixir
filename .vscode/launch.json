{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "mix_task",
      "name": "mix test (guessing-game)",
      "request": "launch",
      "task": "test",
      "taskArgs": ["--trace"],
      "startApps": true,
      "projectDir": "${workspaceFolder}/guessing-game",
      "requireFiles": [
        "test/**/test_helper.exs",
        "test/**/*_test.exs"
      ]
    },
    {
      "type": "mix_task",
      "name": "mix test (current file)",
      "request": "launch",
      "task": "test",
      "taskArgs": ["${file}"],
      "startApps": true,
      "projectDir": "${workspaceFolder}/guessing-game",
      "requireFiles": [
        "test/**/test_helper.exs",
        "test/**/*_test.exs"
      ]
    }
  ]
}
